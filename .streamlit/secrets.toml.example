# COPIE este arquivo para .streamlit/secrets.toml e preencha com sua connection
# string real do Supabase. NUNCA suba o secrets.toml de verdade pro GitHub —
# ele já está no .gitignore por segurança.
#
# Onde pegar a connection string:
# 1. Entre no seu projeto em supabase.com
# 2. Vá em "Project Settings" (ícone de engrenagem) > "Database"
# 3. Em "Connection string", escolha o modo "Transaction pooler" (porta 6543)
#    — é o recomendado para apps como este, que abrem/fecham conexões curtas
# 4. Copie a URI e substitua [YOUR-PASSWORD] pela senha do seu banco
#
# Exemplo de formato (não é uma credencial real):
SUPABASE_DB_URL = "postgresql://postgres.xxxxxxxxxxxx:SUA_SENHA_AQUI@aws-0-sa-east-1.pooler.supabase.com:6543/postgres"
